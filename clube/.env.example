# Configuração do Clube NPV — somente ambiente de teste
# Copie os nomes das variáveis para o ambiente Preview da Vercel.
# Insira valores SOMENTE no painel seguro da hospedagem, NUNCA num commit.
#
# A URL e a publishable key são públicas e protegidas pelas regras RLS
# implantadas no Postgres. NUNCA use service_role/secret key com prefixo VITE_.
VITE_CLUBE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_CLUBE_SUPABASE_PUBLISHABLE_KEY=COLE_SUA_CHAVE_PUBLICAVEL
