      "destination": "/api/instagram/admin?npv_ig_route=callback"
    },
    {
      "source": "/api/instagram/reply",
      "destination": "/api/instagram/admin?npv_ig_route=reply"
    },
    {
      "source": "/api/instagram/diagnostics",
      "destination": "/api/instagram/admin?npv_ig_route=diagnostics"
    },
    {
      "source": "/api/instagram/deauthorize",
      "destination": "/api/instagram/admin?npv_ig_route=deauthorize"
    },
    {
      "source": "/api/instagram/data-deletion",
      "destination": "/api/instagram/admin?npv_ig_route=data-deletion"
    },
    {
      "source": "/api/instagram/data-deletion/status",
      "destination": "/api/instagram/admin?npv_ig_route=deletion-status"
